# Keep the public documentation focused on Atlas. The older local reference
# files remain on disk but are intentionally excluded from the public repo.
docs/**
!docs/
!docs/index.md
!docs/architecture.md
!docs/workflow.md
!docs/design.md
!docs/getting-started.md
!docs/validation.md

# Publish only curated examples.
examples/**
!examples/
!examples/README.md
!examples/requests.http

# Do not inherit upstream publishing/deployment workflows.
.github/workflows/*
!.github/workflows/ci.yml
.github/FUNDING.yml

# Local helper scripts and application-specific generated databases
scripts/
symbology-style.db
